/target
/images
*.log
.DS_Store

# `nix build` output symlinks — `result` by default, `result-<name>` wherever
# a workflow passes --out-link (nix.yml builds several packages per run).
/result
/result-*

/agent/target
/daemon/target

# Node dependencies, wherever they land (desktop/, web/).
node_modules/

# Cross-compiled guest agent binaries — regenerate with `make agent`.
/core/src/agent-bin/bsdkrun-agent.*

# `bsdkrun pack` Go binary, compiled by core/build.rs and embedded via
# rust_embed — regenerated on every `cargo build` with `pack` enabled.
/core/src/pack-bin/bsdkrun-pack
# Stray local build output from `go build` inside pack/ (e.g. `go build .`
# with no -o) — the real output always goes through core/build.rs above.
/pack/pack

# The Solo5 hvt tender, built from the library/solo5 submodule by
# core/build.rs and embedded via rust_embed — same deal as the pack binary.
/core/src/solo5-bin/solo5-hvt

# MirageOS example build artifacts. `mirage configure` generates the whole
# dune/opam scaffolding — only config.ml and unikernel.ml are written by hand,
# and a committed Makefile would pin the mirage version the example builds with.
examples/**/dist/
examples/**/duniverse/
examples/**/mirage/
examples/mirage-*/_build/
examples/mirage-*/Makefile
examples/mirage-*/dune
examples/mirage-*/dune-project
examples/mirage-*/dune-workspace
examples/mirage-*/dune.build
examples/mirage-*/dune.config

# Unikraft example build artifacts.
examples/**/.rootfs-arm64/
examples/**/.rust-cache/
examples/**/*.dbg
examples/**/*.dbg.*

# `bsdkrun pack` writes a Kraftfile into the project it packs. For an example
# that keeps a hand-written one, running pack there overwrites it — and a
# `git add -A` then commits the generated file over the original, silently
# replacing a tuned Kraftfile with a default one. Ignore pack's other
# outputs everywhere so that mistake cannot spread; the Kraftfile itself is
# tracked per-example (unikraft-go ignores it, the hand-written ones do not).
examples/**/.rootfs-*/
examples/**/.Kraftfile.*
examples/**/.config.*

# Zig's build cache, written into whatever project `zig build` runs in.
.zig-cache/
zig-out/


*.dylib

.clj-kondo
.lsp
