/target
/images
*.log
.DS_Store

/agent/target
/daemon/target

# Node dependencies, wherever they land (desktop/, web/).
node_modules/

# Cross-compiled guest agent binaries — regenerate with `make agent`.
/core/src/agent-bin/bsdkrun-agent.*

# `bsdkrun pack` Go binary, compiled by core/build.rs and embedded via
# rust_embed — regenerated on every `cargo build` with `pack` enabled.
/core/src/pack-bin/bsdkrun-pack
# Stray local build output from `go build` inside pack/ (e.g. `go build .`
# with no -o) — the real output always goes through core/build.rs above.
/pack/pack

# Unikraft example build artifacts.
examples/**/.rootfs-arm64/
examples/**/.rust-cache/
examples/**/*.dbg
examples/**/*.dbg.*

# `bsdkrun pack` writes a Kraftfile into the project it packs. For an example
# that keeps a hand-written one, running pack there overwrites it — and a
# `git add -A` then commits the generated file over the original, silently
# replacing a tuned Kraftfile with a default one. Ignore pack's other
# outputs everywhere so that mistake cannot spread; the Kraftfile itself is
# tracked per-example (unikraft-go ignores it, the hand-written ones do not).
examples/**/.rootfs-*/
examples/**/.Kraftfile.*
examples/**/.config.*
