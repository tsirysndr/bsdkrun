{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bsdkrun Desktop",
  "version": "0.1.0",
  "identifier": "dev.bsdkrun.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "bsdkrun Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b0e14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "GUI for bsdkrun microVMs",
    "longDescription": "A Docker Desktop-style GUI for bsdkrun — run FreeBSD, NetBSD, Linux (OCI), and unikernel microVMs on macOS and Linux."
  }
}
