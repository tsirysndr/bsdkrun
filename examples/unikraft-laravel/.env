APP_NAME=unikraft-laravel
APP_ENV=production
# A demo key, committed on purpose: this example has nothing to encrypt and
# a unikernel image is not where a real one would live. Laravel refuses to
# boot without one — MissingAppKeyException, before any route runs.
APP_KEY=base64:AQ/33UF+i11L0W7A4HezkgLEAXCnaigcji6WZ0RAXUY=
APP_DEBUG=false
# A guest has no filesystem worth persisting to and no syslog; stderr goes
# to the serial console, which is the only place anyone will read it.
LOG_CHANNEL=stderr
SESSION_DRIVER=array
CACHE_STORE=array
