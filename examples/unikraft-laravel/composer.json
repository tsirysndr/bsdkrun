{
  "name": "bsdkrun/unikraft-laravel",
  "description": "A Laravel HTTP service running as a Unikraft unikernel",
  "require": {
    "php": ">=8.2",
    "laravel/framework": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "scripts": {
    "test": "php -l public/index.php && php -l bootstrap/app.php"
  }
}