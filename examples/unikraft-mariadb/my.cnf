[mariadbd]
datadir                     = /var/lib/mysql
socket                      = /tmp/mysqld.sock
pid-file                    = /tmp/mysqld.pid
bind-address                = 0.0.0.0
port                        = 3306

# Unikraft constraints
#
# The guest has neither io_uring nor io_submit(), so InnoDB's native AIO
# cannot be used; without this mariadbd fails at startup rather than
# degrading. (liburing.so is still in the image -- mariadbd links it -- it
# just must never be asked to set a ring up.)
innodb_use_native_aio       = 0
# lwip is built without DNS (CONFIG_LWIP_DNS=n), so a reverse lookup of every
# connecting client would block until it times out. Nothing in this image
# reads /etc/hosts either.
skip_name_resolve           = ON
# One thread fewer, and nothing here schedules events.
event_scheduler             = OFF

# Memory
#
# The whole image is resident twice at boot -- embedded in the kernel and
# again unpacked into ramfs -- so keep the server's own appetite small. This
# is a demo database, not a write-heavy one.
performance_schema          = OFF
innodb_buffer_pool_size     = 64M
innodb_log_file_size        = 16M
max_connections             = 32
table_open_cache            = 400

# TLS is off (the MariaDB default when no certificates are configured, stated
# here for the reader): certificates baked into a public image at build time
# would hand every user of the image the same private key. Terminate TLS in
# front of the guest instead.
