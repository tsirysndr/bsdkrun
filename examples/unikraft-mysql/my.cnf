[mysqld]
datadir                     = /var/lib/mysql
socket                      = /tmp/mysqld.sock
pid-file                    = /tmp/mysqld.pid
bind-address                = 0.0.0.0
port                        = 3306

# Unikraft constraints
#
# The guest has no io_submit(), so InnoDB's native AIO cannot be used; without
# this mysqld fails at startup with "io_setup() failed with EAGAIN" and falls
# over rather than degrading.
innodb_use_native_aio       = 0
# lwip is built without DNS (CONFIG_LWIP_DNS=n), so a reverse lookup of every
# connecting client would block until it times out. Nothing in this image reads
# /etc/hosts either.
skip_name_resolve           = ON
# The X protocol listener is a second network stack user (port 33060 and a unix
# socket) that nothing here connects to.
mysqlx                      = OFF
# The whole image is resident twice at boot -- embedded in the kernel and again
# unpacked into ramfs -- so keep the log files small. This is a demo database,
# not a write-heavy one.
innodb_redo_log_capacity    = 8388608

# One thread fewer, and nothing here schedules events. Its creation fails with
# EAGAIN in the guest, which mysqld treats as fatal ("Can not create thread for
# event scheduler") rather than degrading.
event_scheduler             = OFF

# Memory
#
# performance_schema alone reserves on the order of 100 MiB of instrumentation
# tables at startup. Turning it off, plus a small buffer pool, is what lets this
# boot in 2 GiB.
performance_schema          = OFF
innodb_buffer_pool_size     = 64M
max_connections             = 32
table_definition_cache      = 400
table_open_cache            = 400

# TLS is off: the certificates a server generates on first start would have been
# baked into the image at build time, so every user of the image would share the
# same private key. Terminate TLS in front of the guest instead. (An empty
# tls_version is how 8.0.26+ spells this; --ssl=OFF and --skip-ssl are both
# deprecated and warn.)
tls_version                 =

# The datadir ships without the *.pem a server generates on first start (see
# the Dockerfile). Left to itself mysqld regenerates them at boot and then
# chmods them, which ramfs does not support -- "Could not set file permission
# for ca.pem", and it aborts. Nothing here needs them: TLS is off above, and
# the RSA keypairs only matter to the sha256/caching_sha2 plugins, which the
# baked accounts do not use.
auto_generate_certs                        = OFF
sha256_password_auto_generate_rsa_keys     = OFF
caching_sha2_password_auto_generate_rsa_keys = OFF

log_error_verbosity         = 2
