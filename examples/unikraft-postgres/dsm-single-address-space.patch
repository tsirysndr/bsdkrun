 {
+	/*
+	 * Single-address-space implementation.
+	 *
+	 * Upstream backs each segment with a file under PG_DYNSHMEM_DIR and maps
+	 * it MAP_SHARED, which is how two processes with separate address spaces
+	 * come to see the same bytes.  Neither half of that works on Unikraft:
+	 * mmap() supports MAP_SHARED for anonymous mappings only, so mapping the
+	 * file fails outright --
+	 *
+	 *   ERR: [libposix_mmap] mmap(..., flags=1, fd=5, ...) failed: -95
+	 *   FATAL:  could not map shared memory segment "pg_dynshmem/mmap.NNN"
+	 *
+	 * -- and mapping it MAP_PRIVATE instead "works" but gives every process a
+	 * private copy, so the postmaster's control segment reads back as garbage
+	 * in the child:
+	 *
+	 *   FATAL:  dynamic shared memory control segment is not valid
+	 *
+	 * But a single address space makes the whole exercise unnecessary. Every
+	 * process here shares one page table, so an anonymous mapping made by the
+	 * postmaster is already visible, at the same address, to every process it
+	 * spawns. The file is therefore demoted from storage to a *name*: it holds
+	 * the address and length of an anonymous mapping, and attaching is a
+	 * lookup rather than a mapping.
+	 *
+	 * Consequences worth stating:
+	 *
+	 *  - DSM_OP_DETACH does not unmap. There is one mapping shared by
+	 *    everyone, so a detaching process must not pull it out from under the
+	 *    others; only DSM_OP_DESTROY unmaps.
+	 *  - The contents do not survive a reboot, which is correct: dynamic
+	 *    shared memory is never expected to.
+	 */
+	struct dsm_uk_desc
+	{
+		uint64		magic;
+		uint64		addr;
+		uint64		size;
+	}			desc;
+	const uint64 DSM_UK_MAGIC = UINT64CONST(0x554b44534d303031);	/* "UKDSM001" */
 	char		name[64];
 	int			flags;
 	int			fd;
