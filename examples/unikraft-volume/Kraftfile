spec: v0.6

name: volume

unikraft:
  version: stable
  kconfig:
    # libkrun's aarch64 console is a PL011 (see ../unikraft-helloworld).
    CONFIG_LIBPL011: 'y'
    CONFIG_LIBPL011_EARLY_CONSOLE: 'y'

    # Volumes come in over virtio-fs: it is the only shared-directory
    # transport libkrun implements (it has no virtio-9p, which is what
    # `kraft run -v` uses under QEMU), and the only Unikraft filesystem that
    # can be backed by a host directory.
    CONFIG_LIBVIRTIO_FS: 'y'
    CONFIG_LIBUKFS_VIRTIOFS: 'y'

    # The virtiofs driver lives on the newer ukfs/posix-vfs stack, which is
    # mutually exclusive with vfscore (lib/posix-vfs/Config.uk: depends on
    # !LIBVFSCORE). Nothing here uses vfscore, so we select the new one.
    CONFIG_LIBPOSIX_VFS: 'y'
    CONFIG_LIBUKFS: 'y'
    CONFIG_LIBUKFILE: 'y'

    # A mountpoint has to exist before anything can be mounted on it, and a
    # unikernel starts with no filesystem at all. bsdkrun's generated fstab
    # mounts a ramfs at / first and creates the rest with `mkmp`, so ramfs
    # must be built in — without it the boot fails with -ENODEV.
    CONFIG_LIBUKFS_RAMFS: 'y'

    # Mount table from the kernel command line, so the *host* decides what is
    # mounted where. bsdkrun generates this from `--mount`; see
    # src/unikraft.rs for the exact form and the two traps in it.
    CONFIG_LIBPOSIX_VFS_FSTAB: 'y'
    CONFIG_LIBPOSIX_VFS_FSTAB_USER: 'y'

    # Nothing here opens /dev, and leaving it out keeps the image smaller.
    CONFIG_LIBPOSIX_VFS_FSTAB_MOUNT_DEV: 'n'

targets:
- fc/arm64
- fc/x86_64
