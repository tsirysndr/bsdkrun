# Generated by `bsdkrun flavor __dockerfiles` — do not edit.
#
# Flavor: dagger (runtime)
# Dagger CLI on Docker-in-Docker (dagger call, dagger run).
#
# Published as ghcr.io/tsirysndr/bsdkrun-flavor-dagger:latest and pulled by `bsdkrun flavor run dagger`,
# so a first launch does not have to provision a VM.
FROM docker:dind

# bsdkrun runs a guest as root with no service manager, and provisions
# in one shell per step — the same shape as these RUN layers.
SHELL ["/bin/sh", "-c"]
ENV DOCKER_TLS_CERTDIR=
ENV DAGGER_VERSION=

RUN apk add --no-cache curl >/dev/null 2>&1 || true

RUN if [ -n "$DAGGER_VERSION" ]; then curl -fsSL https://dl.dagger.io/dagger/install.sh | DAGGER_VERSION="$DAGGER_VERSION" BIN_DIR=/usr/local/bin sh; else curl -fsSL https://dl.dagger.io/dagger/install.sh | BIN_DIR=/usr/local/bin sh; fi

RUN dagger version

