# Generated by `bsdkrun flavor __dockerfiles` — do not edit.
#
# Flavor: laravel (language)
# PHP 8.3 + Composer + Node for Laravel apps.
#
# Published as ghcr.io/tsirysndr/bsdkrun-flavor-laravel:latest and pulled by `bsdkrun flavor run laravel`,
# so a first launch does not have to provision a VM.
FROM php:8.3-cli

# bsdkrun runs a guest as root with no service manager, and provisions
# in one shell per step — the same shape as these RUN layers.
SHELL ["/bin/sh", "-c"]
RUN apt-get update && apt-get install -y git unzip curl libzip-dev nodejs npm

RUN docker-php-ext-install zip pdo pdo_mysql >/dev/null 2>&1 || true

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

