# Generated by `bsdkrun flavor __dockerfiles` — do not edit.
#
# Flavor: nanoclaw (ai)
# nanoclaw — containerised AI assistant (needs Docker; run ./nanoclaw.sh).
#
# Published as ghcr.io/tsirysndr/bsdkrun-flavor-nanoclaw:latest and pulled by `bsdkrun flavor run nanoclaw`,
# so a first launch does not have to provision a VM.
FROM docker:dind

# bsdkrun runs a guest as root with no service manager, and provisions
# in one shell per step — the same shape as these RUN layers.
SHELL ["/bin/sh", "-c"]
ENV DOCKER_TLS_CERTDIR=

RUN apk add --no-cache git nodejs npm curl bash >/dev/null 2>&1 || (apt-get update && apt-get install -y git nodejs npm curl bash)

RUN npm install -g pnpm

RUN git clone --depth 1 https://github.com/nanocoai/nanoclaw.git /opt/nanoclaw

RUN echo 'cd /opt/nanoclaw && ./nanoclaw.sh' > /etc/bsdkrun-motd

