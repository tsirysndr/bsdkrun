# Generated by `bsdkrun flavor __dockerfiles` — do not edit.
#
# Flavor: php (language)
# PHP 8.3 CLI with Composer.
#
# Published as ghcr.io/tsirysndr/bsdkrun-flavor-php:latest and pulled by `bsdkrun flavor run php`,
# so a first launch does not have to provision a VM.
FROM php:8.3-cli

# bsdkrun runs a guest as root with no service manager, and provisions
# in one shell per step — the same shape as these RUN layers.
SHELL ["/bin/sh", "-c"]
RUN command -v composer >/dev/null || (curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer)

