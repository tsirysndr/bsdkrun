# Flavor: symfony (language)
# PHP 8.3 + Composer + Symfony CLI.
#
# Published as ghcr.io/tsirysndr/bsdkrun-flavor-symfony:latest and pulled by `bsdkrun flavor run symfony`,
# so a first launch does not have to provision a VM.
FROM php:8.3-cli

# bsdkrun runs a guest as root with no service manager, and provisions
# in one shell per step — the same shape as these RUN layers.
SHELL ["/bin/sh", "-c"]
RUN apt-get update && apt-get install -y git unzip curl

RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer

RUN curl -1sLf https://get.symfony.com/cli/installer | bash || true

