+#if CONFIG_UKPLAT_PREEMPT
+/* Reprogram channel 0 as a rate generator at the preemption tick.
+ *
+ * tscclock_init() already leaves the PIT in this mode at CONFIG_HZ, and a
+ * sleep only rewrites the divisor -- so in principle the tick is always there.
+ * In practice "in principle" is how this went wrong once already: arm64's
+ * timer turned out to be armed only by time_block_until(), and a guest whose
+ * threads all spin took no interrupts at all. Programming it explicitly costs
+ * two port writes at boot and removes the question.
+ *
+ * A sleep longer than the tick will stretch the period until the next tick
+ * fires and this is called again; that is a latency question, not a
+ * correctness one, since time_block_until() re-checks the clock in a loop.
+ */
+void tscclock_arm_preempt_tick(void)
+{
+	unsigned long div = (unsigned long)TIMER_HZ
+			    * CONFIG_UKPLAT_PREEMPT_TICK_US / 1000000UL;
+
+	if (div < 2)
+		div = 2;
+	if (div > 65535)
+		div = 65535;
+
+	uk_arch_x86_64_outb(TIMER_MODE,
+			    TIMER_SEL0 | TIMER_RATEGEN | TIMER_16BIT);
+	uk_arch_x86_64_outb(TIMER_CNTR, div & 0xff);
+	uk_arch_x86_64_outb(TIMER_CNTR, div >> 8);
+}
+#endif /* CONFIG_UKPLAT_PREEMPT */
+
