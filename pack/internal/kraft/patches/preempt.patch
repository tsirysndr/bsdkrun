+ * The extended context has to be saved by hand. uk_sched_thread_switch() does
+ * not save it -- deliberately, because with cooperative scheduling a switch
+ * only ever happens at a function call boundary -- but a preempted thread is
+ * suspended at an arbitrary instruction with live vector registers, and the
+ * thread we switch to will use them. The kernel itself never touches FP/SIMD
+ * (arm64 is built -mgeneral-regs-only), so the interrupted thread's registers
+ * are still intact here, several calls deep into the kernel.
+ */
+void uk_plat_native_preempt_trampoline(struct uk_plat_native_regs *frame,
+				       struct uk_plat_native_ectx *ectx)
+{
+	/* The buffer is a fresh slice of the thread's stack, so its XSAVE
+	 * header is whatever was there before. Both calls are required by
+	 * contract: "must be called on newly allocated memory before any
+	 * save/restore", and a store into an unsanitized area is what
+	 * makes the later restore #GP.
